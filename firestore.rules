rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Students collection (Lab members)
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Attendance records (Check-in & Check-out logs)
    match /attendance/{recordId} {
      allow read, write: if true;
    }

    // Schedules (Lab & Club Schedule - Public Read, Admin Write)
    match /schedules/{scheduleId} {
      allow read, write: if true;
    }

    // Portfolios (Showcase projects - Public Read, Admin Write)
    match /portfolios/{portfolioId} {
      allow read, write: if true;
    }

    // Activities & Events (Public Read, Admin Write)
    match /activities/{activityId} {
      allow read, write: if true;
    }

    // Lab Settings & Schedules
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Test connection document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
