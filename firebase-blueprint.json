{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Registered IT Club student member profile with RFID and QR credentials",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nisn": { "type": "string" },
        "name": { "type": "string" },
        "class": { "type": "string" },
        "division": { "type": "string" },
        "rfidUid": { "type": "string" },
        "qrCodeData": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "parentName": { "type": "string" },
        "parentPhone": { "type": "string" },
        "joinedDate": { "type": "string" },
        "status": { "type": "string", "enum": ["Aktif", "Alumni", "Pengurus"] },
        "position": { "type": "string" }
      },
      "required": ["id", "nisn", "name", "class", "division", "rfidUid", "qrCodeData", "status"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Log entry of student lab attendance tap (Masuk or Pulang)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "class": { "type": "string" },
        "nisn": { "type": "string" },
        "division": { "type": "string" },
        "method": { "type": "string", "enum": ["RFID", "QR Code", "Manual"] },
        "status": { "type": "string", "enum": ["Hadir", "Terlambat", "Izin"] },
        "tapType": { "type": "string", "enum": ["Masuk", "Pulang"] },
        "sessionTitle": { "type": "string" },
        "notes": { "type": "string" },
        "parentPhone": { "type": "string" },
        "waSent": { "type": "boolean" }
      },
      "required": ["id", "timestamp", "studentId", "studentName", "class", "nisn", "division", "method", "status", "tapType"]
    },
    "ScheduleItem": {
      "title": "ScheduleItem",
      "description": "Lab computer class and extracurricular schedule item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "day": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "instructor": { "type": "string" },
        "room": { "type": "string" },
        "capacity": { "type": "number" },
        "description": { "type": "string" }
      },
      "required": ["id", "day", "startTime", "endTime", "title", "category", "instructor", "room"]
    },
    "PortfolioItem": {
      "title": "PortfolioItem",
      "description": "Student project showcase and portfolio item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "studentAuthors": { "type": "array" },
        "gradeClass": { "type": "string" },
        "imageUrl": { "type": "string" },
        "demoUrl": { "type": "string" },
        "githubUrl": { "type": "string" },
        "featured": { "type": "boolean" },
        "date": { "type": "string" },
        "techTags": { "type": "array" }
      },
      "required": ["id", "title", "category", "description", "studentAuthors", "gradeClass"]
    },
    "LabSetting": {
      "title": "LabSetting",
      "description": "Lab schedule and instructor settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "instructorName": { "type": "string" },
        "instructorNip": { "type": "string" },
        "masukTime": { "type": "string" },
        "lateThresholdTime": { "type": "string" },
        "pulangTime": { "type": "string" }
      },
      "required": ["id"]
    },
    "WhatsAppSetting": {
      "title": "WhatsAppSetting",
      "description": "Automated WhatsApp gateway and Fonnte API token configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "mode": { "type": "string", "enum": ["gateway", "direct"] },
        "provider": { "type": "string", "enum": ["fonnte", "custom", "demo"] },
        "apiKey": { "type": "string" },
        "customEndpoint": { "type": "string" },
        "enabled": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "mode", "provider", "enabled"]
    },
    "ActivityEvent": {
      "title": "ActivityEvent",
      "description": "School lab workshops, internal competitions, and club activities",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "location": { "type": "string" },
        "description": { "type": "string" },
        "speaker": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["Mendatang", "Sedang Berlangsung", "Selesai"] },
        "registeredCount": { "type": "number" },
        "maxParticipants": { "type": "number" }
      },
      "required": ["id", "title", "date", "time", "location", "description", "speaker", "category", "status", "maxParticipants"]
    },
    "StudentAssessment": {
      "title": "StudentAssessment",
      "description": "IT Club student evaluation rubric scores and progress report for parents/guardians",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "nisn": { "type": "string" },
        "class": { "type": "string" },
        "division": { "type": "string" },
        "period": { "type": "string" },
        "assessmentDate": { "type": "string" },
        "attendanceScore": { "type": "number" },
        "materialScore": { "type": "number" },
        "practiceScore": { "type": "number" },
        "creativityScore": { "type": "number" },
        "finalScore": { "type": "number" },
        "grade": { "type": "string", "enum": ["A", "B", "C", "D"] },
        "predicate": { "type": "string" },
        "projectTitle": { "type": "string" },
        "coachNotes": { "type": "string" },
        "recommendation": { "type": "string" },
        "instructorName": { "type": "string" },
        "published": { "type": "boolean" },
        "waSent": { "type": "boolean" },
        "waSentAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "studentId", "studentName", "nisn", "division", "period", "finalScore", "grade", "published"]
    },
    "ActivityRegistration": {
      "title": "ActivityRegistration",
      "description": "Participant registration submission when clicking Ikuti Kegiatan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "activityId": { "type": "string" },
        "activityTitle": { "type": "string" },
        "participantName": { "type": "string", "maxLength": 120 },
        "participantClass": { "type": "string", "maxLength": 80 },
        "participantWhatsapp": { "type": "string", "maxLength": 30 },
        "reason": { "type": "string", "maxLength": 1000 },
        "preferredChannel": { "type": "string", "enum": ["whatsapp", "email"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "activityId", "activityTitle", "participantName", "participantClass", "participantWhatsapp", "reason", "preferredChannel", "createdAt"]
    },
    "LearningModule": {
      "title": "LearningModule",
      "description": "Editable IT Club learning modules with PDF/Video links and starter code",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 180 },
        "track": { "type": "string" },
        "level": { "type": "string", "enum": ["Dasar", "Menengah", "Lanjutan"] },
        "duration": { "type": "string" },
        "lessons": { "type": "number" },
        "description": { "type": "string", "maxLength": 2000 },
        "syllabus": { "type": "array" },
        "starterCode": { "type": "string", "maxLength": 10000 },
        "starterLanguage": { "type": "string" },
        "pdfUrl": { "type": "string", "maxLength": 500 },
        "videoUrl": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "track", "level", "duration", "lessons", "description", "syllabus"]
    },
    "TaskSubmission": {
      "title": "TaskSubmission",
      "description": "Student assignment and project link submissions for modules",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "moduleId": { "type": "string" },
        "moduleTitle": { "type": "string" },
        "studentName": { "type": "string", "maxLength": 120 },
        "nisn": { "type": "string", "maxLength": 40 },
        "studentClass": { "type": "string", "maxLength": 60 },
        "division": { "type": "string" },
        "projectUrl": { "type": "string", "maxLength": 500 },
        "notes": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["Menunggu", "Dinilai", "Perlu Revisi"] },
        "feedback": { "type": "string", "maxLength": 1000 },
        "score": { "type": "number" },
        "submittedAt": { "type": "string" }
      },
      "required": ["id", "moduleId", "moduleTitle", "studentName", "nisn", "studentClass", "division", "projectUrl", "status", "submittedAt"]
    },
    "LabAnnouncement": {
      "title": "LabAnnouncement",
      "description": "Quick announcement banners displayed on the home page",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 160 },
        "content": { "type": "string", "maxLength": 800 },
        "priority": { "type": "string", "enum": ["Info", "Penting", "Lomba", "Libur"] },
        "active": { "type": "boolean" },
        "authorName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "content", "priority", "active", "authorName", "createdAt"]
    },
    "StaffRoleEntry": {
      "title": "StaffRoleEntry",
      "description": "Authorized Pembina & Pengurus Google emails for multi-role RBAC",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["guru_admin", "pengurus"] },
        "addedBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "name", "role", "addedBy", "createdAt"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Collection of registered IT Club students"
    },
    "/attendance/{recordId}": {
      "schema": "AttendanceRecord",
      "description": "Collection of attendance check-in and check-out logs"
    },
    "/schedules/{scheduleId}": {
      "schema": "ScheduleItem",
      "description": "Collection of lab schedules and club meetings"
    },
    "/portfolios/{portfolioId}": {
      "schema": "PortfolioItem",
      "description": "Collection of student portfolio projects"
    },
    "/activities/{activityId}": {
      "schema": "ActivityEvent",
      "description": "Collection of school IT Club activities, workshops and competitions"
    },
    "/settings/{settingId}": {
      "schema": "LabSetting",
      "description": "Lab configuration settings"
    },
    "/assessments/{assessmentId}": {
      "schema": "StudentAssessment",
      "description": "Collection of student IT Club evaluations and progress reports for parents"
    },
    "/activity_registrations/{registrationId}": {
      "schema": "ActivityRegistration",
      "description": "Collection of participant registrations for IT Club activities"
    },
    "/learning_modules/{moduleId}": {
      "schema": "LearningModule",
      "description": "Collection of editable IT Club learning modules"
    },
    "/task_submissions/{submissionId}": {
      "schema": "TaskSubmission",
      "description": "Collection of student task and project submissions"
    },
    "/announcements/{announcementId}": {
      "schema": "LabAnnouncement",
      "description": "Collection of lab announcement banners"
    },
    "/staff_roles/{emailKey}": {
      "schema": "StaffRoleEntry",
      "description": "Collection of authorized Pembina and Pengurus roles"
    }
  }
}
